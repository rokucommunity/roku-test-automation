{
    "name": "roku-test-automation",
    "version": "3.0.0-alpha.2",
    "description": "Helps with automating functional tests",
    "main": "dist/index.js",
    "typings": "dist/index.d.ts",
    "scripts": {
        "preversion": "npm run build && npm run lint && npm run test && npm run validate-client && npm run audit",
        "build": "npm run clean && tsc && npm run buildSchemas",
        "watch": "npm run clean && tsc --watch",
        "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
        "lint": "eslint \"./src/**/*.ts\"",
        "audit": "npm audit --audit-level=high || audit-ci --config ./audit-ci.jsonc",
        "test": "nyc mocha \"./src/**/*.spec.ts\" --ignore \"./src/**/*.device.spec.ts\"",
        "test:device": "mocha \"./src/**/*.device.spec.ts\"",
        "test:all": "nyc mocha \"./src/**/*.spec.ts\"",
        "validate-client": "npx bsc --project bsconfig.json --create-package false --copy-to-staging false --diagnostic-reporters detailed github-actions",
        "buildConfigSchema": "typescript-json-schema src/types/ConfigOptions.ts ConfigOptions --out rta-config.schema.json --noExtraProps --refs false --required --ignoreErrors",
        "buildRequestTypesSchema": "typescript-json-schema src/types/OnDeviceComponent.ts RequestType --out requestTypes.schema.json --ignoreErrors",
        "buildRequestArgsSchema": "typescript-json-schema src/types/OnDeviceComponent.ts RequestArgs --propOrder --out requestArgs.schema.json --ignoreErrors",
        "buildSchemas": "npm run buildConfigSchema && npm run buildRequestArgsSchema && npm run buildRequestTypesSchema",
        "package": "npm run build && npm pack",
        "pack:dev": "npm run package && node -e \"r=require,f='roku-test-automation-'+r('./package').version;r('fs').renameSync(f+'.tgz',f+`-dev.${Date.now()}.tgz`)\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rokucommunity/roku-test-automation"
    },
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rokucommunity/roku-test-automation/issues"
    },
    "homepage": "https://github.com/rokucommunity/roku-test-automation#readme",
    "dependencies": {
        "@types/express": "^5.0.0",
        "ajv": "^6.12.6",
        "express": "^4.21.2",
        "fs-extra": "^7.0.1",
        "http-proxy-middleware": "^3.0.7",
        "needle": "^2.9.1",
        "path": "^0.12.7",
        "portfinder": "^1.0.33",
        "roku-deploy": "^4.0.0-alpha.5",
        "sax": "^1.6.1",
        "stoppable": "^1.1.0"
    },
    "devDependencies": {
        "@rokucommunity/bslint": "^0.8.44",
        "@types/chai": "^4.3.0",
        "@types/chai-arrays": "^2.0.0",
        "@types/fs-extra": "^5.0.1",
        "@types/mocha": "^10.0.10",
        "@types/needle": "^2.5.2",
        "@types/node": "^13.13.52",
        "@types/sax": "^1.2.7",
        "@types/sinon": "^7.5.2",
        "@types/xmljs": "^0.3.2",
        "@typescript-eslint/eslint-plugin": "^5.22.0",
        "@typescript-eslint/parser": "^5.22.0",
        "audit-ci": "^7.1.0",
        "brighterscript": "^0.73.1",
        "chai": "^4.3.4",
        "chai-arrays": "^2.2.0",
        "dotenv": "^17.4.2",
        "eslint": "^8.14.0",
        "mocha": "^10.8.2",
        "nyc": "^15.1.0",
        "sinon": "^7.2.3",
        "source-map-support": "^0.5.21",
        "ts-node": "^10.9.2",
        "typescript": "^4.7.2",
        "typescript-json-schema": "^0.42.0",
        "wtfnode": "^0.8.4"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5",
        "brace-expansion": "^2.1.4",
        "js-yaml": "^4.3.1",
        "qs": "^6.16.0",
        "uuid": "^11.1.1",
        "browserslist": "^4.28.8"
    },
    "files": [
        "dist/**/!(*.spec.*)*",
        "device/**/*",
        "!**/bsconfig.json",
        "rta-config.schema.json",
        "requestArgs.schema.json",
        "requestTypes.schema.json"
    ],
    "nyc": {
        "include": [
            "src/**/*.ts",
            "!src/**/*.spec.ts"
        ],
        "exclude": [
            "src/test/**/*"
        ],
        "extension": [
            ".ts"
        ],
        "require": [
            "ts-node/register",
            "source-map-support/register"
        ],
        "reporter": [
            "text-summary",
            "html",
            "lcovonly"
        ],
        "sourceMap": true,
        "instrument": true,
        "check-coverage": false,
        "lines": 100,
        "statements": 100,
        "functions": 100,
        "branches": 100
    }
}
