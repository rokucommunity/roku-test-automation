{
    "name": "roku-test-automation",
    "version": "2.2.2",
    "description": "Helps with automating functional tests",
    "main": "client/dist/index.js",
    "typings": "client/dist/index.d.ts",
    "scripts": {
        "build": "rm -f tsconfig.tsbuildinfo && rimraf dist && tsc",
        "test": "nyc mocha \"./src/**/*.spec.ts\" --ignore \"./src/**/*.device.spec.ts\"",
        "lint": "eslint \"./src/**/*.ts\"",
        "validate-client": "npx bsc --project bsconfig.json --create-package false --copy-to-staging false --diagnostic-reporters detailed github-actions",
        "test:device": "mocha \"./src/**/*.device.spec.ts\"",
        "test:all": "nyc mocha \"./src/**/*.spec.ts\"",
        "buildConfigSchema": "typescript-json-schema src/types/ConfigOptions.ts ConfigOptions --out rta-config.schema.json --noExtraProps --refs false --required --ignoreErrors",
        "buildRequestTypesSchema": "typescript-json-schema src/types/OnDeviceComponent.ts RequestType --out requestTypes.schema.json --ignoreErrors",
        "buildRequestArgsSchema": "typescript-json-schema src/types/OnDeviceComponent.ts RequestArgs --propOrder --out requestArgs.schema.json --ignoreErrors",
        "buildRelease": "npx ts-node scripts/buildRelease.ts",
        "buildRelease:alpha": "npx ts-node scripts/buildRelease.ts --alpha",
        "buildRelease:beta": "npx ts-node scripts/buildRelease.ts --beta",
        "buildRelease:dev": "npx ts-node scripts/buildRelease.ts --dev",
        "increment:beta": "npm version prerelease"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rokucommunity/roku-test-automation"
    },
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rokucommunity/roku-test-automation/issues"
    },
    "homepage": "https://github.com/rokucommunity/roku-test-automation#readme",
    "dependencies": {
        "@suitest/types": "^4.6.0",
        "@types/express": "^5.0.0",
        "ajv": "^6.12.6",
        "express": "^4.21.2",
        "fs-extra": "^7.0.1",
        "http-proxy-middleware": "^3.0.3",
        "needle": "^2.9.1",
        "path": "^0.12.7",
        "portfinder": "^1.0.33",
        "postman-request": "^2.88.1-postman.40",
        "roku-deploy": "^3.10.2",
        "stoppable": "^1.1.0"
    },
    "devDependencies": {
        "@rokucommunity/bslint": "^0.7.3",
        "@types/chai": "^4.3.0",
        "@types/chai-arrays": "^2.0.0",
        "@types/fs-extra": "^5.0.1",
        "@types/mocha": "^8.2.3",
        "@types/needle": "^2.5.2",
        "@types/node": "^13.13.52",
        "@types/sinon": "^7.5.2",
        "@types/xmljs": "^0.3.2",
        "@typescript-eslint/eslint-plugin": "^5.22.0",
        "@typescript-eslint/parser": "^5.22.0",
        "brighterscript": "^0.72.2",
        "chai": "^4.3.4",
        "chai-arrays": "^2.2.0",
        "eslint": "^8.14.0",
        "mocha": "^10.2.0",
        "nyc": "^14.1.1",
        "rimraf": "^2.7.1",
        "sinon": "^7.2.3",
        "source-map-support": "^0.5.21",
        "ts-node": "^8.8.2",
        "typescript": "^4.5.5",
        "typescript-json-schema": "^0.42.0",
        "wtfnode": "^0.8.4"
    },
    "nyc": {
        "include": [
            "src/**/*.ts",
            "!src/**/*.spec.ts"
        ],
        "exclude": [
            "src/test/**/*"
        ],
        "extension": [
            ".ts"
        ],
        "require": [
            "ts-node/register",
            "source-map-support/register"
        ],
        "reporter": [
            "text-summary",
            "html",
            "lcovonly"
        ],
        "sourceMap": true,
        "instrument": true,
        "check-coverage": false,
        "lines": 100,
        "statements": 100,
        "functions": 100,
        "branches": 100
    },
    "mocha": {
        "timeout": 10000,
        "bail": false,
        "require": [
            "ts-node/register",
            "source-map-support/register"
        ],
        "file": [
            "./src/test/include.ts"
        ]
    }
}
