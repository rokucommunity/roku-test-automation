{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Non-Device Tests",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": [
				"./src/**/*.spec.ts",
				"--ignore",
				"./src/**/*.device.spec.ts"
			],
			"console": "internalConsole",
			"internalConsoleOptions": "neverOpen"
		},
		{
			"name": "Debug Device Tests",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": [
				"./src/**/*.device.spec.ts"
			],
			"console": "internalConsole",
			"internalConsoleOptions": "neverOpen"
		},
		{
			"type": "brightscript",
			"request": "launch",
			"name": "Deploy testProject",
			"cwd": "${workspaceFolder}/testProject",
			"retainStagingFolder": true,
			"envFile": "${workspaceFolder}/.env",
			"host": "${env:LAUNCH_HOST_OVERRIDE}",
			"password": "${env:ROKU_PASSWORD}",
			"internalConsoleOptions": "neverOpen",
			"logLevel": "error",
			"stopDebuggerOnAppExit": true,
			"injectRaleTrackerTask": false,
			"injectRdbOnDeviceComponent": true,
			"bsConst": {
				"ENABLE_RTA": false
			}
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Run testProject Tests",
			"cwd": "${workspaceFolder}/testProject",
			"preLaunchTask": "compile-automated-tests",
			"program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
			"args": [
				"./dist/automatedTests/**/*.spec.js"
			],
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen"
		}
	]
}
